APP_NAME=BeikeShop
APP_ENV=local
APP_KEY=base64:3RBtk9D81bfkLAjZ8UK7TSsIsHU+UBukSXx754Rkw1I=
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=PRC
APP_FORCE_HTTPS=false
ASSET_URL=
# 是否启用 TrustHosts 中间件进行 Host 校验，设为 false 可关闭
TRUST_HOSTS_ENABLED=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=beike
DB_USERNAME=root
DB_PASSWORD=

# 展示商品库，cyberCloak 插件阶段一只注册连接，启用商品库读取前再配置并校验
CATALOG_PUBLIC_DB_HOST=127.0.0.1
CATALOG_PUBLIC_DB_PORT=3306
CATALOG_PUBLIC_DB_DATABASE=beike_public
CATALOG_PUBLIC_DB_USERNAME=root
CATALOG_PUBLIC_DB_PASSWORD=

# 留空时按 APP_URL 自动判定；HTTPS 使用 true，纯 HTTP 使用 false。
CYBER_CLOAK_COOKIE_SECURE=

# cyberCloak 基础 IP 信誉网段
CYBER_CLOAK_IP_REPUTATION=

# cyberCloak 四层流量漏斗、本地 MaxMind MMDB 和云 IP 汇总库
CYBER_CLOAK_GEOIP_ENABLED=true
CYBER_CLOAK_GEOIP_COUNTRY_DATABASE=
CYBER_CLOAK_GEOIP_ASN_DATABASE=
CYBER_CLOAK_GEOIP_ANONYMOUS_DATABASE=
CYBER_CLOAK_CLOUD_IP_RANGES_DATABASE=
CYBER_CLOAK_TRAFFIC_FUNNEL_ENABLED=true
CYBER_CLOAK_TRAFFIC_ALLOWED_COUNTRIES=
CYBER_CLOAK_TRAFFIC_BLOCKED_COUNTRIES=
CYBER_CLOAK_TRAFFIC_ALLOWED_LANGUAGES=
CYBER_CLOAK_TRAFFIC_USER_AGENT_BLACKLIST=
CYBER_CLOAK_TRAFFIC_BLOCKED_ASNS=
CYBER_CLOAK_TRAFFIC_DATACENTER_ASNS=
CYBER_CLOAK_TRAFFIC_RATE_LIMIT_ENABLED=false
CYBER_CLOAK_TRAFFIC_RATE_LIMIT_MAX=120
CYBER_CLOAK_TRAFFIC_RATE_LIMIT_DECAY=60
CYBER_CLOAK_TRAFFIC_BLOCK_THRESHOLD=80
CYBER_CLOAK_TRAFFIC_CHALLENGE_THRESHOLD=50
CYBER_CLOAK_TRAFFIC_FINGERPRINT_COOKIE=
CYBER_CLOAK_TRAFFIC_BEHAVIOR_ENABLED=true
CYBER_CLOAK_TRAFFIC_BEHAVIOR_WINDOW=60
CYBER_CLOAK_TRAFFIC_BEHAVIOR_MAX_REQUESTS=60
CYBER_CLOAK_TRAFFIC_BEHAVIOR_MAX_ROUTES=12
CYBER_CLOAK_TRAFFIC_BEHAVIOR_INVALID_COOKIE_MAX=3
CYBER_CLOAK_TRAFFIC_BEHAVIOR_SCORE=20
CYBER_CLOAK_TRAFFIC_RISK_AUDIT_ENABLED=true
CYBER_CLOAK_TRAFFIC_RISK_AUDIT_THRESHOLD=20

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
CYBER_CLOAK_QUEUE_RETRY_AFTER=7200
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Dusk Browser Test
DUSK_START_MAXIMIZED=true
DUSK_HEADLESS_DISABLED=false
